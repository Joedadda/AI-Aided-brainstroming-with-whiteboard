# Sarvam Token Factory key. Without it the app runs on canned AI replies and shows "Offline demo".
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v2
# Set to 1 to force canned replies even with a key.
MOCK_AI=0
# Leave empty for local development: the browser's current origin is used.
APP_URL=
DATABASE_PATH=./data/app.db
PARTNER_NUDGES=false
AI_CALLS_PER_BOARD_PER_HOUR=60
API_PORT=8787
COLLAB_PORT=8788
